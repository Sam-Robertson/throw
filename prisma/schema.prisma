// Prisma schema for Throw — pottery studio booking & membership platform
// All DateTime fields are stored in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum MembershipEventType {
  CREATED
  UPGRADED
  DOWNGRADED
  PAUSED
  RESUMED
  CANCELLED
  RENEWED
  CREDIT_ISSUED
  CREDIT_USED
}

enum BookingStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  MEMBERSHIP_CREDIT
  MEMBER_FREE
  DROP_IN
  COMP
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskTriggerType {
  MANUAL
  AUTOMATION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentType {
  DROP_IN
  MEMBERSHIP
  GIFT_CARD
  TIP
  OTHER
}

// ---------------------------------------------------------------------------
// NextAuth v5 models (exact Auth.js / Prisma adapter spec)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime // UTC

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime // UTC

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Core domain models
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime? // UTC
  name                  String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  hashedPassword        String?
  role                  Role      @default(CUSTOMER)
  stripeCustomerId      String?
  createdAt             DateTime  @default(now()) // UTC
  updatedAt             DateTime  @updatedAt      // UTC

  accounts             Account[]
  sessions             Session[]
  memberships          Membership[]
  bookings             Booking[]
  assignedTasks        StaffTask[]           @relation("AssignedTasks")
  createdTasks         StaffTask[]           @relation("CreatedTasks")
  linkedTasks          StaffTask[]           @relation("LinkedCustomerTasks")
  instructedSessions   StudioSession[]
  staffRoleAssignments StaffRoleAssignment[]
  waiverSignatures     WaiverSignature[]
  payments             Payment[]
  communityPosts       CommunityPost[]
  communityLikes       CommunityLike[]
  communityComments    CommunityComment[]
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  timezone  String   @default("America/Denver")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionTypes    SessionType[]
  studioSessions  StudioSession[]
  memberships     Membership[]
  membershipPlans MembershipPlan[]
  staffRoles      StaffRole[]
  waiverVersions  WaiverVersion[]
  payments        Payment[]
  tips            Tip[]
  adTracking      AdTracking[]
  smsAutomations  SmsAutomation[]
  staffTasks      StaffTask[]
}

model StaffRole {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  permissions Json     // { canViewTips, canViewMembershipReporting, canViewBilling, canManageSchedule, canCheckInMembers, canManageTasks }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location    Location              @relation(fields: [locationId], references: [id])
  assignments StaffRoleAssignment[]
}

model StaffRoleAssignment {
  id          String   @id @default(cuid())
  userId      String
  staffRoleId String
  locationId  String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  staffRole StaffRole @relation(fields: [staffRoleId], references: [id])

  @@unique([userId, locationId])
}

model WaiverVersion {
  id          String   @id @default(cuid())
  locationId  String
  content     String   @db.Text
  version     Int
  publishedAt DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  location   Location          @relation(fields: [locationId], references: [id])
  signatures WaiverSignature[]

  @@unique([locationId, version])
}

model WaiverSignature {
  id              String   @id @default(cuid())
  userId          String
  waiverVersionId String
  signedAt        DateTime
  ipAddress       String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id])
  waiverVersion WaiverVersion @relation(fields: [waiverVersionId], references: [id])

  @@unique([userId, waiverVersionId])
}

model MembershipPlan {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String?
  price                Int      // cents
  billingIntervalDays  Int      // e.g. 28, 84, 365
  hasShelfSpace        Boolean  @default(false)
  hasPriorityBooking   Boolean  @default(false)
  guestPassesPerPeriod Int      @default(0)
  isActive             Boolean  @default(true)
  stripePriceId        String?
  locationId           String?
  createdAt            DateTime @default(now()) // UTC
  updatedAt            DateTime @updatedAt      // UTC

  memberships Membership[]
  location    Location?    @relation(fields: [locationId], references: [id])
}

model Membership {
  id                   String           @id @default(cuid())
  userId               String
  planId               String
  locationId           String?
  status               MembershipStatus @default(ACTIVE)
  stripeSubscriptionId String?          @unique
  stripeCustomerId     String?
  currentPeriodStart   DateTime         // UTC
  currentPeriodEnd     DateTime         // UTC
  creditsRemaining     Int
  pausedAt             DateTime?        // UTC
  resumesAt            DateTime?        // UTC
  cancelledAt          DateTime?        // UTC
  createdAt            DateTime         @default(now()) // UTC
  updatedAt            DateTime         @updatedAt      // UTC

  user             User              @relation(fields: [userId], references: [id])
  plan             MembershipPlan    @relation(fields: [planId], references: [id])
  location         Location?         @relation(fields: [locationId], references: [id])
  membershipEvents MembershipEvent[]
  bookings         Booking[]
}

model MembershipEvent {
  id           String              @id @default(cuid())
  membershipId String
  eventType    MembershipEventType
  note         String?
  createdAt    DateTime            @default(now()) // UTC

  membership Membership @relation(fields: [membershipId], references: [id])
}

model SessionType {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  durationMinutes  Int
  capacity         Int
  dropInPriceCents Int
  isBusyWindow     Boolean  @default(false)
  isActive         Boolean  @default(true)
  locationId       String?
  createdAt        DateTime @default(now()) // UTC
  updatedAt        DateTime @updatedAt      // UTC

  studioSessions StudioSession[]
  location       Location?       @relation(fields: [locationId], references: [id])
}

model StudioSession {
  id            String   @id @default(cuid())
  sessionTypeId String
  instructorId  String?
  locationId    String?
  startsAt      DateTime // UTC
  endsAt        DateTime // UTC
  capacity      Int
  isCancelled   Boolean  @default(false)
  createdAt     DateTime @default(now()) // UTC
  updatedAt     DateTime @updatedAt      // UTC

  sessionType SessionType @relation(fields: [sessionTypeId], references: [id])
  instructor  User?       @relation(fields: [instructorId], references: [id])
  bookings    Booking[]
  location    Location?   @relation(fields: [locationId], references: [id])
}

model Booking {
  id                    String        @id @default(cuid())
  userId                String
  studioSessionId       String
  membershipId          String?
  status                BookingStatus @default(CONFIRMED)
  source                BookingSource
  creditUsed            Boolean       @default(false)
  stripePaymentIntentId String?
  amountPaidCents       Int           @default(0)
  cancelledAt           DateTime?     // UTC
  createdAt             DateTime      @default(now()) // UTC
  updatedAt             DateTime      @updatedAt      // UTC

  user          User          @relation(fields: [userId], references: [id])
  studioSession StudioSession @relation(fields: [studioSessionId], references: [id])
  membership    Membership?   @relation(fields: [membershipId], references: [id])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  locationId            String
  stripePaymentIntentId String        @unique
  amountInCents         Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  type                  PaymentType
  bookingId             String?
  membershipId          String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
}

model Tip {
  id                    String    @id @default(cuid())
  bookingId             String
  customerId            String
  instructorId          String
  locationId            String
  amountInCents         Int
  stripePaymentIntentId String
  paidOutAt             DateTime?
  createdAt             DateTime  @default(now())

  location Location @relation(fields: [locationId], references: [id])
}

model StaffTask {
  id               String          @id @default(cuid())
  title            String
  description      String?
  status           TaskStatus      @default(OPEN)
  triggerType      TaskTriggerType @default(MANUAL)
  dueAt            DateTime?       // UTC
  completedAt      DateTime?       // UTC
  assignedToId     String?
  createdById      String
  linkedCustomerId String?
  locationId       String?
  createdAt        DateTime        @default(now()) // UTC
  updatedAt        DateTime        @updatedAt      // UTC

  assignedTo     User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy      User      @relation("CreatedTasks", fields: [createdById], references: [id])
  linkedCustomer User?     @relation("LinkedCustomerTasks", fields: [linkedCustomerId], references: [id])
  location       Location? @relation(fields: [locationId], references: [id])
}

model SmsAutomation {
  id              String   @id @default(cuid())
  name            String
  triggerEvent    String
  delayMinutes    Int      @default(0)
  messageTemplate String   @db.Text
  isActive        Boolean  @default(true)
  locationId      String?
  createdAt       DateTime @default(now()) // UTC
  updatedAt       DateTime @updatedAt      // UTC

  location Location? @relation(fields: [locationId], references: [id])
}

model AdTracking {
  id              String    @id @default(cuid())
  userId          String?
  sessionId       String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  firstBookingAt  DateTime? // UTC
  firstPurchaseAt DateTime? // UTC
  locationId      String?
  createdAt       DateTime  @default(now()) // UTC

  location Location? @relation(fields: [locationId], references: [id])
}

model SmsLog {
  id           String   @id @default(cuid())
  userId       String
  toPhone      String
  message      String   @db.Text
  twilioSid    String?
  status       String   @default("sent")
  automationId String?
  createdAt    DateTime @default(now())
}

model CommunityPost {
  id          String    @id @default(cuid())
  authorId    String
  locationId  String?
  title       String?
  body        String    @db.Text
  imageUrl    String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User               @relation(fields: [authorId], references: [id])
  likes    CommunityLike[]
  comments CommunityComment[]
}

model CommunityLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])
}

model LandingPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  headline     String
  subheadline  String?
  bodyHtml     String?  @db.Text
  ctaLabel     String
  ctaUrl       String
  heroImageUrl String?
  isActive     Boolean  @default(true)
  locationId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
