// Prisma schema for Throw — pottery studio booking & membership platform
// All DateTime fields are stored in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum MembershipEventType {
  CREATED
  UPGRADED
  DOWNGRADED
  PAUSED
  RESUMED
  CANCELLED
  RENEWED
  CREDIT_ISSUED
  CREDIT_USED
}

enum BookingStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  MEMBERSHIP_CREDIT
  MEMBER_FREE
  DROP_IN
  COMP
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskTriggerType {
  MANUAL
  AUTOMATION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentType {
  DROP_IN
  MEMBERSHIP
  GIFT_CARD
  TIP
  OTHER
}

// ---------------------------------------------------------------------------
// NextAuth v5 models (exact Auth.js / Prisma adapter spec)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime // UTC

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime // UTC

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Core domain models
// ---------------------------------------------------------------------------

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  emailVerified             DateTime? // UTC
  name                      String?
  phone                     String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  hashedPassword            String?
  role                      Role      @default(CUSTOMER)
  stripeCustomerId          String?
  // Store credit a customer can spend at the POS. Integer cents, never negative.
  accountCreditCents        Int       @default(0)
  smsMarketingOptIn         Boolean   @default(false)
  smsMarketingOptInAt       DateTime?
  smsMarketingOptInSource   String?
  emailMarketingOptIn       Boolean   @default(false)
  emailMarketingOptInAt     DateTime?
  emailMarketingOptInSource String?
  createdAt                 DateTime  @default(now()) // UTC
  updatedAt                 DateTime  @updatedAt // UTC

  accounts             Account[]
  sessions             Session[]
  memberships          Membership[]
  bookings             Booking[]
  assignedTasks        StaffTask[]           @relation("AssignedTasks")
  createdTasks         StaffTask[]           @relation("CreatedTasks")
  linkedTasks          StaffTask[]           @relation("LinkedCustomerTasks")
  instructedSessions   StudioSession[]
  staffRoleAssignments StaffRoleAssignment[]
  waiverSignatures     WaiverSignature[]
  payments             Payment[]
  communityPosts       CommunityPost[]
  communityLikes       CommunityLike[]
  communityComments    CommunityComment[]
  payRates             PayRate[]
  conversations        Conversation[]
  posOrdersAsCustomer  PosOrder[]            @relation("PosOrderCustomer")
  posOrdersAsStaff     PosOrder[]            @relation("PosOrderStaff")
  openedCashDrawers    PosCashDrawer[]       @relation("PosCashDrawerOpenedBy")
  closedCashDrawers    PosCashDrawer[]       @relation("PosCashDrawerClosedBy")
  pieces               Piece[]
  loggedPieces         Piece[]               @relation("PieceLoggedBy")
  classCreditLedger    ClassCreditLedger[]
  discountRedemptions  DiscountRedemption[]
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  timezone  String   @default("America/Denver")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe Terminal Location (tml_...) this studio maps to. Card readers are
  // registered against a Stripe Terminal Location, so this is what lets the POS
  // list "the readers in this studio". Null until linked in Studio setup.
  stripeTerminalLocationId String?

  // Sendblue line that receives this studio's texts. Inbound messages are
  // scoped to the location whose smsNumber matches the receiving number; null
  // means conversations arriving on it stay visible to every location.
  smsNumber  String?
  taxEnabled Boolean @default(true)

  // Structured address for Stripe Tax (which needs a postal code). `address`
  // above stays as the free-text display string.
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?

  sessionTypes           SessionType[]
  studioSessions         StudioSession[]
  memberships            Membership[]
  membershipPlans        MembershipPlan[]
  staffRoles             StaffRole[]
  waivers                Waiver[]
  waiverVersions         WaiverVersion[]
  payments               Payment[]
  tips                   Tip[]
  adTracking             AdTracking[]
  smsAutomations         SmsAutomation[]
  staffTasks             StaffTask[]
  retailProducts         RetailProduct[]
  discountCodes          DiscountCode[]
  giftCards              GiftCard[]
  transactionalTemplates TransactionalTemplate[]
  posOrders              PosOrder[]
  posCashDrawers         PosCashDrawer[]
  shelfSpaces            ShelfSpace[]
  shelfWaitlistEntries   ShelfWaitlistEntry[]
  conversations          Conversation[]
  pieces                 Piece[]
  sessionTypePrices      SessionTypeLocationPrice[]
  membershipCapGroups    MembershipCapGroup[]
  membershipAddOns       MembershipAddOn[]
  freezePolicy           FreezePolicy?
}

model StaffRole {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  permissions Json // { canViewTips, canViewMembershipReporting, canViewBilling, canManageSchedule, canCheckInMembers, canManageTasks }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location    Location              @relation(fields: [locationId], references: [id])
  assignments StaffRoleAssignment[]
}

model StaffRoleAssignment {
  id          String   @id @default(cuid())
  userId      String
  staffRoleId String
  locationId  String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  staffRole StaffRole @relation(fields: [staffRoleId], references: [id])

  @@unique([userId, locationId])
}

// A waiver is one document customers sign: the class waiver, a membership
// agreement, a workshop release. Each can be for one studio or every studio,
// and its text changes over time as WaiverVersions (only one active at once).
//   kind: CLASS      — required before booking or attending a class there
//         MEMBERSHIP — required before starting a membership there
//         OTHER      — signed on request via its link or QR code
model Waiver {
  id          String    @id @default(cuid())
  name        String
  kind        String    @default("CLASS")
  // Null means the waiver applies at every studio.
  locationId  String?
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  location Location?       @relation(fields: [locationId], references: [id])
  versions WaiverVersion[]

  @@index([kind, locationId])
}

model WaiverVersion {
  id          String   @id @default(cuid())
  // Rows published before Sept 2026 were backfilled into one CLASS waiver per
  // studio; the app always sets waiverId. locationId mirrors the waiver's.
  waiverId    String?
  locationId  String?
  content     String   @db.Text
  version     Int
  publishedAt DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  waiver     Waiver?           @relation(fields: [waiverId], references: [id])
  location   Location?         @relation(fields: [locationId], references: [id])
  signatures WaiverSignature[]

  @@unique([waiverId, version])
}

model WaiverSignature {
  id                 String   @id @default(cuid())
  userId             String
  waiverVersionId    String
  signedAt           DateTime
  ipAddress          String
  createdAt          DateTime @default(now())
  signatureImageData String?  @db.Text
  typedName          String?
  // "platform" (signed here) or "momence" (imported historical signature,
  // with signedAt set from the source data).
  source             String   @default("platform")

  user          User          @relation(fields: [userId], references: [id])
  waiverVersion WaiverVersion @relation(fields: [waiverVersionId], references: [id])

  @@unique([userId, waiverVersionId])
}

model MembershipPlan {
  id                           String    @id @default(cuid())
  name                         String
  slug                         String    @unique
  description                  String?
  price                        Int // cents
  billingIntervalDays          Int // e.g. 28, 84, 365
  hasShelfSpace                Boolean   @default(false)
  hasPriorityBooking           Boolean   @default(false)
  guestPassesPerPeriod         Int       @default(0)
  isActive                     Boolean   @default(true)
  stripePriceId                String?
  locationId                   String?
  classTicketsPerPeriod        Int? // null means unlimited
  ticketRolloverEnabled        Boolean   @default(false)
  ticketRolloverMaxTickets     Int? // cap on carried-over tickets, null = no cap
  joiningFeeCents              Int       @default(0)
  commitmentMonths             Int? // null means month to month
  retailDiscountPercent        Int       @default(0)
  shelfType                    String? // "FULL" | "HALF" | null for none
  includesGuestPass            Boolean   @default(false)
  includesOnlineCourse         Boolean   @default(false)
  billingAnchorDay             Int? // 1 means bill on the 1st, null means anniversary
  perks                        Json? // array of strings for the marketing page
  // --- Catalog fields (docs/throw-catalog.md section 4) ---
  tier                         String? // "BASIC" | "PRO" | "EXPERT" | "STUDENT": groups a plan across studios
  // Public plans show on the marketing site and can be bought online.
  // Non-public plans (legacy) are only ever assigned by staff.
  isPublic                     Boolean   @default(true)
  isLegacy                     Boolean   @default(false)
  isFounding                   Boolean   @default(false)
  // Founding plans share one cap across tiers through a cap group.
  capGroupId                   String?
  // The rate is lost if the member cancels or freezes (founding plans).
  forfeitsRateOnCancelOrFreeze Boolean   @default(false)
  // Seeded from another studio's price and not yet confirmed by the client.
  priceNeedsConfirmation       Boolean   @default(false)
  archivedAt                   DateTime?
  createdAt                    DateTime  @default(now()) // UTC
  updatedAt                    DateTime  @updatedAt // UTC

  memberships Membership[]
  location    Location?           @relation(fields: [locationId], references: [id])
  capGroup    MembershipCapGroup? @relation(fields: [capGroupId], references: [id])
}

// A shared cap on how many memberships can be sold across a set of plans,
// e.g. "50 Lehi founding members in total across Basic, Pro and Expert".
model MembershipCapGroup {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  cap        Int
  locationId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location?        @relation(fields: [locationId], references: [id])
  plans    MembershipPlan[]
}

// Commitment terms are independent of the tier: any standard plan can be
// taken month to month, on 3 months, or on 12 months. months = null is
// month to month.
model CommitmentTerm {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  months                Int?
  joiningFeeCents       Int      @default(0)
  retailDiscountPercent Int      @default(0)
  includesGuestPass     Boolean  @default(false)
  includesVideoLibrary  Boolean  @default(false)
  freeMonths            Int      @default(0)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  memberships Membership[]
}

// Paid extras on top of a membership (guest pass).
model MembershipAddOn {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  description         String?
  priceCents          Int? // null = not priced yet, stays inactive
  billingIntervalDays Int       @default(30)
  stripePriceId       String?
  locationId          String?
  isActive            Boolean   @default(true)
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  location    Location?                   @relation(fields: [locationId], references: [id])
  assignments MembershipAddOnAssignment[]
}

model MembershipAddOnAssignment {
  id           String    @id @default(cuid())
  membershipId String
  addOnId      String
  // True when the add-on comes with the commitment term rather than being paid for.
  included     Boolean   @default(false)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  membership Membership      @relation(fields: [membershipId], references: [id])
  addOn      MembershipAddOn @relation(fields: [addOnId], references: [id])

  @@index([membershipId])
}

// Freeze rules per studio. Null amounts mean "not decided yet" (catalog OPEN).
model FreezePolicy {
  id                        String   @id @default(cuid())
  locationId                String   @unique
  monthlyFeeCents           Int?
  creditCentsPerFrozenMonth Int?
  forfeitsFoundingRate      Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
}

model Membership {
  id                   String           @id @default(cuid())
  userId               String
  planId               String
  locationId           String?
  status               MembershipStatus @default(ACTIVE)
  stripeSubscriptionId String?          @unique
  stripeCustomerId     String?
  currentPeriodStart   DateTime // UTC
  currentPeriodEnd     DateTime // UTC
  creditsRemaining     Int
  pausedAt             DateTime? // UTC
  resumesAt            DateTime? // UTC
  cancelledAt          DateTime? // UTC
  commitmentEndsAt     DateTime?
  joiningFeePaid       Boolean          @default(false)
  commitmentTermId     String?
  createdAt            DateTime         @default(now()) // UTC
  updatedAt            DateTime         @updatedAt // UTC

  user                 User                        @relation(fields: [userId], references: [id])
  plan                 MembershipPlan              @relation(fields: [planId], references: [id])
  location             Location?                   @relation(fields: [locationId], references: [id])
  membershipEvents     MembershipEvent[]
  bookings             Booking[]
  creditLedger         MembershipCreditLedger[]
  shelfSpace           ShelfSpace?
  shelfWaitlistEntries ShelfWaitlistEntry[]
  commitmentTerm       CommitmentTerm?             @relation(fields: [commitmentTermId], references: [id])
  addOns               MembershipAddOnAssignment[]
}

// type vocabulary, enforced in code:
//   ALLOWANCE  granted at the start of a billing period, positive
//   ROLLOVER   carried from the prior period, positive
//   BOOKING    consumed by a booking, negative
//   REFUND     returned when a booking is cancelled, positive
//   ADJUSTMENT manual grant or deduction by an admin, either sign
//   EXPIRY     zeroing out unused tickets at period end, negative
model MembershipCreditLedger {
  id           String   @id @default(cuid())
  membershipId String
  type         String
  delta        Int
  bookingId    String?
  periodStart  DateTime
  periodEnd    DateTime
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, createdAt])
  @@index([membershipId, periodStart])
}

model MembershipEvent {
  id           String              @id @default(cuid())
  membershipId String
  eventType    MembershipEventType
  note         String?
  metadata     Json?
  createdAt    DateTime            @default(now()) // UTC

  membership Membership @relation(fields: [membershipId], references: [id])
}

model ShelfSpace {
  id           String   @id @default(cuid())
  locationId   String
  number       Int
  shelfType    String // "FULL" | "HALF"
  membershipId String?  @unique
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location   Location    @relation(fields: [locationId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@unique([locationId, number])
}

model ShelfWaitlistEntry {
  id            String    @id @default(cuid())
  locationId    String
  membershipId  String
  requestedType String // "FULL" | "HALF"
  notifiedAt    DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  location   Location   @relation(fields: [locationId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])
}

model SessionType {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  description        String?
  durationMinutes    Int
  capacity           Int
  dropInPriceCents   Int
  isBusyWindow       Boolean   @default(false)
  isActive           Boolean   @default(true)
  // Whether this shows up in the reusable "Event Templates" picker (recurring
  // classes/courses meant to be scheduled again) vs. a one-off historical
  // artifact (a private event, a single workshop) that shouldn't clutter it.
  // New rows default false; creating a class type by hand through the admin
  // UI explicitly sets true, since defining one IS the act of making a template.
  isTemplate         Boolean   @default(false)
  locationId         String?
  // --- Catalog fields (docs/throw-catalog.md section 2) ---
  kind               String    @default("EVENT") // "EVENT" | "COURSE"
  tags               String[]  @default([])
  // What dropInPriceCents buys. A wheel can seat more than one person.
  priceUnit          String    @default("PER_PERSON") // "PER_WHEEL" | "PER_PERSON" | "FLAT"
  maxPeoplePerWheel  Int       @default(1)
  allowsWheelSharing Boolean   @default(false)
  // Members can book it with a class ticket.
  isTicketEligible   Boolean   @default(true)
  // Only members can book it; never sold as a drop-in.
  membersOnly        Boolean   @default(false)
  // Private types (group events, internal blocks) never show on the public
  // schedule or in the POS class list.
  isPublic           Boolean   @default(true)
  // Price for an active member when it differs (private lessons). Null = same price.
  memberPriceCents   Int?
  minAge             Int?
  maxAge             Int?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now()) // UTC
  updatedAt          DateTime  @updatedAt // UTC

  studioSessions StudioSession[]
  location       Location?                  @relation(fields: [locationId], references: [id])
  locationPrices SessionTypeLocationPrice[]
  discountCodes  DiscountCode[]
}

// Price of a class type at one studio. Overrides SessionType.dropInPriceCents
// for sessions held there.
model SessionTypeLocationPrice {
  id               String   @id @default(cuid())
  sessionTypeId    String
  locationId       String
  priceCents       Int
  memberPriceCents Int?
  // False while the client hasn't confirmed the number.
  isConfirmed      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessionType SessionType @relation(fields: [sessionTypeId], references: [id])
  location    Location    @relation(fields: [locationId], references: [id])

  @@unique([sessionTypeId, locationId])
}

model StudioSession {
  id                       String   @id @default(cuid())
  sessionTypeId            String
  instructorId             String?
  locationId               String?
  startsAt                 DateTime // UTC
  endsAt                   DateTime // UTC
  capacity                 Int
  isCancelled              Boolean  @default(false)
  // Groups sessions created together by "repeat weekly". No separate series
  // model — sessions sharing a seriesId are the series.
  seriesId                 String?
  // Display title for this session when it differs from the class type
  // (a workshop's topic, a private group's name).
  title                    String?
  // Price for this session only (workshops are priced per session).
  priceCentsOverride       Int?
  isTicketEligibleOverride Boolean?
  createdAt                DateTime @default(now()) // UTC
  updatedAt                DateTime @updatedAt // UTC

  sessionType SessionType @relation(fields: [sessionTypeId], references: [id])
  instructor  User?       @relation(fields: [instructorId], references: [id])
  bookings    Booking[]
  location    Location?   @relation(fields: [locationId], references: [id])
  pieces      Piece[]

  @@index([seriesId])
}

model Booking {
  id                    String        @id @default(cuid())
  userId                String
  studioSessionId       String
  membershipId          String?
  status                BookingStatus @default(CONFIRMED)
  source                BookingSource
  creditUsed            Boolean       @default(false)
  stripePaymentIntentId String?
  amountPaidCents       Int           @default(0)
  // Set when the booking was created by a POS DROP_IN line item.
  posOrderItemId        String?       @unique
  // Wheels (or seats) this booking holds.
  quantity              Int           @default(1)
  cancelledAt           DateTime? // UTC
  createdAt             DateTime      @default(now()) // UTC
  updatedAt             DateTime      @updatedAt // UTC

  user          User          @relation(fields: [userId], references: [id])
  studioSession StudioSession @relation(fields: [studioSessionId], references: [id])
  membership    Membership?   @relation(fields: [membershipId], references: [id])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  locationId            String
  stripePaymentIntentId String        @unique
  // Set for subscription invoice payments (renewals), for idempotency.
  stripeInvoiceId       String?       @unique
  amountInCents         Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  type                  PaymentType
  bookingId             String?
  membershipId          String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
}

model Tip {
  id                    String    @id @default(cuid())
  bookingId             String
  customerId            String
  instructorId          String
  locationId            String
  amountInCents         Int
  stripePaymentIntentId String
  paidOutAt             DateTime?
  createdAt             DateTime  @default(now())

  location Location @relation(fields: [locationId], references: [id])
}

model StaffTask {
  id               String          @id @default(cuid())
  title            String
  description      String?
  status           TaskStatus      @default(OPEN)
  triggerType      TaskTriggerType @default(MANUAL)
  dueAt            DateTime? // UTC
  completedAt      DateTime? // UTC
  assignedToId     String?
  createdById      String
  linkedCustomerId String?
  locationId       String?
  createdAt        DateTime        @default(now()) // UTC
  updatedAt        DateTime        @updatedAt // UTC

  assignedTo     User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy      User      @relation("CreatedTasks", fields: [createdById], references: [id])
  linkedCustomer User?     @relation("LinkedCustomerTasks", fields: [linkedCustomerId], references: [id])
  location       Location? @relation(fields: [locationId], references: [id])
}

model SmsAutomation {
  id              String   @id @default(cuid())
  name            String
  triggerEvent    String
  delayMinutes    Int      @default(0)
  messageTemplate String   @db.Text
  isActive        Boolean  @default(true)
  locationId      String?
  createdAt       DateTime @default(now()) // UTC
  updatedAt       DateTime @updatedAt // UTC

  location Location? @relation(fields: [locationId], references: [id])
}

model AdTracking {
  id              String    @id @default(cuid())
  userId          String?
  sessionId       String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  firstBookingAt  DateTime? // UTC
  firstPurchaseAt DateTime? // UTC
  locationId      String?
  createdAt       DateTime  @default(now()) // UTC

  location Location? @relation(fields: [locationId], references: [id])
}

model SmsLog {
  id                String   @id @default(cuid())
  userId            String
  toPhone           String
  message           String   @db.Text
  // Sendblue's message_handle (was Twilio's message SID before the provider swap).
  providerMessageId String?
  // Sendblue reports which rail actually carried the message: "iMessage" or "SMS".
  providerService   String?
  status            String   @default("sent")
  // "transactional" (booking/membership/receipt sends, never consent-gated) or
  // "marketing" (campaign sends — must be checked against canSendMarketing()
  // before sending; that enforcement doesn't exist yet, this field is just
  // the audit trail for when it does).
  kind              String   @default("transactional")
  automationId      String?
  createdAt         DateTime @default(now())
}

model CommunityPost {
  id          String   @id @default(cuid())
  authorId    String
  locationId  String?
  title       String?
  body        String   @db.Text
  imageUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User               @relation(fields: [authorId], references: [id])
  likes    CommunityLike[]
  comments CommunityComment[]
}

model CommunityLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])
}

model LandingPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  headline     String
  subheadline  String?
  bodyHtml     String?  @db.Text
  ctaLabel     String
  ctaUrl       String
  heroImageUrl String?
  isActive     Boolean  @default(true)
  locationId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Studio Set-up models
// ---------------------------------------------------------------------------

model PayRate {
  id          String   @id @default(cuid())
  userId      String
  rateType    String   @default("hourly") // "hourly" | "per_session"
  amountCents Int // cents per hour or per session
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RetailProduct {
  id             String    @id @default(cuid())
  name           String
  description    String?
  priceCents     Int
  sku            String?
  inventory      Int       @default(0)
  imageUrl       String?
  isActive       Boolean   @default(true)
  locationId     String?
  // --- Catalog fields (docs/throw-catalog.md sections 2.2 and 3) ---
  slug           String?   @unique // stable key for the sync script
  category       String    @default("RETAIL") // "RETAIL" | "PIECES" | "FIRING" | "CLAY" | "CLASS_PACK" | "SHIPPING"
  unit           String    @default("EACH") // "EACH" | "LB"
  // False while the catalog has no price for it; such products stay inactive.
  isPriced       Boolean   @default(true)
  // Per-line minimum for by-weight products (member firing: $1 per piece).
  minChargeCents Int?
  // Only active members and enrolled students can buy it (member firing).
  membersOnly    Boolean   @default(false)
  // Pieces, firing, packs and shipping don't carry stock.
  trackInventory Boolean   @default(true)
  // Class credits granted when bought (class packs).
  classCredits   Int?
  taxCode        String? // Stripe Tax product tax code; null = category default
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  location Location? @relation(fields: [locationId], references: [id])
}

// Class pack credits. Never expire, not shareable. Balance = sum(delta).
//   PURCHASE   bought a pack, positive
//   BOOKING    spent on a booking, negative
//   REFUND     booking cancelled, positive
//   ADJUSTMENT manual, either sign
model ClassCreditLedger {
  id             String   @id @default(cuid())
  userId         String
  delta          Int
  type           String
  note           String?
  posOrderItemId String?
  bookingId      String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model DiscountCode {
  id                        String    @id @default(cuid())
  code                      String    @unique
  description               String?
  type                      String    @default("percent") // "percent" | "fixed_cents"
  value                     Int // percent 0-100 OR fixed cents
  maxUses                   Int?
  usedCount                 Int       @default(0)
  validFrom                 DateTime?
  validUntil                DateTime?
  isActive                  Boolean   @default(true)
  locationId                String?
  // --- Catalog fields (docs/throw-catalog.md section 6) ---
  name                      String?
  scope                     String    @default("EVERYTHING") // "RETAIL" | "PIECES" | "CLASSES" | "EVERYTHING"
  appliesVia                String    @default("CODE") // "AUTOMATIC" | "CODE" | "STAFF"
  // AUTOMATIC discounts apply when the attached member's commitment is this long.
  autoCommitmentMonths      Int?
  // Limit to one class type (KICKSTART50) or one product (Get Out Pass: the 1 lb piece).
  sessionTypeId             String?
  productSlug               String?
  // Most units of the matching item one use can discount (one piece, one wheel).
  maxUnits                  Int?
  maxUsesPerCustomerPerYear Int?
  requiresNote              Boolean   @default(false)
  requiresGroupEvent        Boolean   @default(false)
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  location          Location?            @relation(fields: [locationId], references: [id])
  sessionType       SessionType?         @relation(fields: [sessionTypeId], references: [id])
  redemptions       DiscountRedemption[]
  posOrderDiscounts PosOrderDiscount[]
}

model DiscountRedemption {
  id             String   @id @default(cuid())
  discountCodeId String
  userId         String?
  posOrderId     String?
  bookingId      String?
  amountCents    Int
  note           String?
  createdAt      DateTime @default(now())

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([discountCodeId, userId])
}

model GiftCard {
  id            String    @id @default(cuid())
  code          String    @unique
  initialCents  Int
  balanceCents  Int
  purchasedById String?
  redeemedById  String?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  locationId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  location Location? @relation(fields: [locationId], references: [id])
}

model TransactionalTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  trigger     String // e.g. "booking_confirmed", "membership_renewed"
  channel     String   @default("email") // "email" | "sms"
  subject     String? // email subject
  body        String   @db.Text
  isActive    Boolean  @default(true)
  locationId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location? @relation(fields: [locationId], references: [id])
}

// ---------------------------------------------------------------------------
// Inbox / Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  channel       String    @default("in_app") // "email" | "sms" | "in_app"
  subject       String? // email thread subject
  adminUnread   Int       @default(0)
  lastMessageAt DateTime?
  // Studio whose SMS line received the conversation. Null = visible to all.
  locationId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User                  @relation(fields: [userId], references: [id])
  location Location?             @relation(fields: [locationId], references: [id])
  messages ConversationMessage[]

  @@index([locationId])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String   @default("outbound") // "inbound" | "outbound"
  body           String   @db.Text
  subject        String?
  isRead         Boolean  @default(true)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Marketing consent / suppression
// ---------------------------------------------------------------------------

model SuppressionEntry {
  id        String   @id @default(cuid())
  channel   String // "SMS" | "EMAIL"
  value     String // normalized phone (E.164) or lowercased email
  reason    String // "USER_UNSUBSCRIBED" | "STOP_REPLY" | "BOUNCE" | "COMPLAINT" | "MANUAL"
  userId    String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([channel, value])
  @@index([value])
}

// ---------------------------------------------------------------------------
// Point of sale
// ---------------------------------------------------------------------------
// Value vocabularies below are enforced in application code, not the DB:
//   PosOrder.status:      OPEN | COMPLETED | VOIDED | REFUNDED
//   PosOrderItem.itemType: RETAIL | DROP_IN | MEMBERSHIP | GIFT_CARD | CUSTOM
//   PosPayment.method:     CASH | CARD_TERMINAL | CARD_MANUAL | GIFT_CARD | COMP
//   PosPayment.status:     PENDING | SUCCEEDED | FAILED | REFUNDED

model PosOrder {
  id                     String    @id @default(cuid())
  orderNumber            Int       @unique @default(autoincrement())
  locationId             String
  customerId             String?
  staffId                String
  status                 String    @default("OPEN")
  subtotalCents          Int       @default(0)
  discountCents          Int       @default(0)
  taxCents               Int       @default(0)
  tipCents               Int       @default(0)
  totalCents             Int       @default(0)
  // Latest Stripe Tax calculation (taxcalc_...) for the current items; turned
  // into a tax transaction when the order completes.
  stripeTaxCalculationId String?
  note                   String?
  // Walk-in class sales with no account: who the seat is for.
  walkInName             String?
  walkInPhone            String?
  // Set while the order is set aside for a customer who stepped away.
  parkedAt               DateTime?
  completedAt            DateTime?
  voidedAt               DateTime?
  voidReason             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  location  Location           @relation(fields: [locationId], references: [id])
  customer  User?              @relation("PosOrderCustomer", fields: [customerId], references: [id])
  staff     User               @relation("PosOrderStaff", fields: [staffId], references: [id])
  items     PosOrderItem[]
  payments  PosPayment[]
  discounts PosOrderDiscount[]

  @@index([locationId, createdAt])
  @@index([status])
}

model PosOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  itemType       String
  refId          String?
  name           String
  quantity       Int      @default(1)
  unitPriceCents Int
  discountCents  Int      @default(0)
  totalCents     Int
  taxCents       Int      @default(0)
  taxCode        String? // Stripe Tax product tax code; null = nontaxable
  metadata       Json?
  note           String?
  // Product category at the time of sale, so discounts can be scoped.
  category       String?
  createdAt      DateTime @default(now())

  order PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// A named discount on an order. amountCents is recomputed on every reprice
// and spread across the matching items' discountCents.
model PosOrderDiscount {
  id             String   @id @default(cuid())
  orderId        String
  discountCodeId String?
  name           String
  amountCents    Int      @default(0)
  automatic      Boolean  @default(false)
  note           String?
  appliedById    String?
  createdAt      DateTime @default(now())

  order        PosOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])

  @@index([orderId])
}

model PosPayment {
  id                    String   @id @default(cuid())
  orderId               String
  method                String
  amountCents           Int
  status                String   @default("PENDING")
  stripePaymentIntentId String?
  giftCardId            String?
  cashTenderedCents     Int?
  cashChangeCents       Int?
  externalRef           String?
  createdAt             DateTime @default(now())

  order PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PosCashDrawer {
  id                String    @id @default(cuid())
  locationId        String
  openedById        String
  closedById        String?
  openingFloatCents Int
  expectedCashCents Int?
  countedCashCents  Int?
  varianceCents     Int?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  note              String?

  location Location @relation(fields: [locationId], references: [id])
  openedBy User     @relation("PosCashDrawerOpenedBy", fields: [openedById], references: [id])
  closedBy User?    @relation("PosCashDrawerClosedBy", fields: [closedById], references: [id])

  @@index([locationId, openedAt])
}

// ---------------------------------------------------------------------------
// Pottery pieces
// ---------------------------------------------------------------------------

// Only INTAKE is used as of the Sept 2026 launch; the rest exist so the
// October status-tracking work needs no further migration.
enum PieceStatus {
  INTAKE
  DRYING
  BISQUE
  GLAZE
  READY
  PICKED_UP
}

model Piece {
  id              String      @id @default(cuid())
  userId          String
  studioSessionId String?
  locationId      String
  groupName       String?
  pieceCount      Int
  description     String
  photoUrls       String[]
  sharePermission Boolean
  status          PieceStatus @default(INTAKE)
  weightOz        Int?
  chargedCents    Int?
  posOrderItemId  String?
  // Who to text when the pieces are ready — what the customer wrote on the
  // form, which may differ from the account's name/phone. E.164.
  contactName     String?
  contactPhone    String?
  // "Text me when my pottery is ready" — consent for the ready-for-pickup text.
  textOptIn       Boolean     @default(false)
  instructorName  String?
  // Front-desk only.
  staffNote       String?
  bagged          Boolean     @default(false)
  readyNotifiedAt DateTime?
  pickedUpAt      DateTime?
  // Staff user who logged it at the desk; null when the customer logged it.
  loggedById      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  studioSession StudioSession? @relation(fields: [studioSessionId], references: [id])
  location      Location       @relation(fields: [locationId], references: [id])
  loggedBy      User?          @relation("PieceLoggedBy", fields: [loggedById], references: [id])

  @@index([locationId, status])
  @@index([userId])
}
