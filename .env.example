DATABASE_URL=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TZ="UTC"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key for the client-side Stripe Elements card entry in the POS terminal
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Sendblue (iMessage/SMS sending API) - see sendblue.com dashboard for keys.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# E.164 number provisioned on the Sendblue account (GET /api/lines to look it up).
SENDBLUE_FROM_NUMBER=
# Configured via POST /api/account/webhooks (secret or global_secret) - Sendblue
# echoes this back verbatim in the `sb-signing-secret` header on every webhook
# call, so /api/webhooks/sendblue/inbound can verify requests are really from
# Sendblue. Must be set for the webhook to accept anything (it fails closed).
SENDBLUE_WEBHOOK_SECRET=
# Full URL of /api/webhooks/sendblue/inbound (e.g. https://yourdomain.com/api/webhooks/sendblue/inbound).
# Register it as the account's "receive" webhook (POST /api/account/webhooks)
# so inbound SMS/iMessage replies (STOP/START/HELP and customer messages) reach the app.
SENDBLUE_WEBHOOK_URL=
RESEND_API_KEY=
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# One-time Momence data export (scripts/momence-export.ts). Create the API
# client at momence.com/dashboard/profile?host-redirect=public-api-clients,
# and use a staff account's login for the username/password.
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=

# Catalog-only export (scripts/momence-catalog-export.ts) via the simpler
# widget/plugin API token, found on the dashboard's website-widgets page.
MOMENCE_HOST_ID=
MOMENCE_WIDGET_TOKEN=
